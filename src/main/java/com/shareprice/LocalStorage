package components;

import interfaces.IStoreData;

import java.util.ArrayList;
import java.util.List;

public class LocalStorage implements IStoreData {

    private List<String> storage = new ArrayList<>();

    @Override
    public void saveData(List<String> data) {
        System.out.println("Saving data locally...");
        storage.addAll(data);
    }

    @Override
    public List<String> loadData() {
        System.out.println("Loading data from storage...");
        return storage;
    }
}
