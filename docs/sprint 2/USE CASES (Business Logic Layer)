package usecase;

import interfaces.SharePriceRepository;
import domain.SharePrice;

import java.time.LocalDate;
import java.util.List;

public class GetSharePriceUseCase {
    private SharePriceRepository repository;

    public GetSharePriceUseCase(SharePriceRepository repository) {
        this.repository = repository;
    }

    public List<SharePrice> execute(String symbol, LocalDate start, LocalDate end) {
        return repository.getPrices(symbol, start, end);
    }
}
